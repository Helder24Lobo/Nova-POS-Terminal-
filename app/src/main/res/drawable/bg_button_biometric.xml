<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_celeste">
    <item>
        <selector>
            <!-- Pressed/Focused State -->
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="@color/input_bg_focused" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_primary" />
                    <size
                        android:width="56dp"
                        android:height="56dp" />
                </shape>
            </item>
            <item android:state_focused="true">
                <shape android:shape="oval">
                    <solid android:color="@color/input_bg_focused" />
                    <stroke
                        android:width="1.5dp"
                        android:color="@color/color_primary" />
                    <size
                        android:width="56dp"
                        android:height="56dp" />
                </shape>
            </item>
            <!-- Normal/Default State -->
            <item>
                <shape android:shape="oval">
                    <solid android:color="@color/input_bg_normal" />
                    <stroke
                        android:width="1dp"
                        android:color="@color/input_border_normal" />
                    <size
                        android:width="56dp"
                        android:height="56dp" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
